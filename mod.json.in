{
  "id": "com.usuario.parry",
  "name": "Twilight Parry",
  "version": "1.0.0",
  "author": "ScrappySkyler",
  "description": "Parry system: This mod disables auto-blocking for greater immersion. The parry is activated by pressing the R trigger (shield bash). The enemy will then be stunned, allowing you to follow up with a maximum of two Mortal Draws."
}
